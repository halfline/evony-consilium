{
  "name": "evony-consilium",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.js",
    "build": "node scripts/build.js",
    "build:apps-script": "node scripts/build-apps-script.js",
    "apps-script:link": "node scripts/upload-apps-script.js link",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.js",
    "format": "prettier --write \"web/{app.js,index.html,style.css,src/**/*.js,styles/*.css}\" \"scripts/*.{js,cjs}\" \"apps-script/*.{js,json}\" \"tests/**/*.js\" \"docs/*.md\" README.md PRIVACY.md TERMS.md package.json",
    "format:check": "prettier --check \"web/{app.js,index.html,style.css,src/**/*.js,styles/*.css}\" \"scripts/*.{js,cjs}\" \"apps-script/*.{js,json}\" \"tests/**/*.js\" \"docs/*.md\" README.md PRIVACY.md TERMS.md package.json",
    "assets": "node scripts/assets.js",
    "test:assets": "node --test tests/generated-assets/*.test.js"
  },
  "devDependencies": {
    "@pixi-spine/runtime-3.8": "^4.0.6",
    "esbuild": "0.28.2",
    "playwright": "1.56.1",
    "prettier": "3.6.2"
  }
}
